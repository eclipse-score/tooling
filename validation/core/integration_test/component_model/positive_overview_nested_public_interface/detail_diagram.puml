' Detail: nests an *internal* interface under component_a. overview_diagram.puml
' nests a different, *public* interface under the same component_a. Neither
' file contains the other's interface, but interfaces are not "children" for
' the purpose of the single-home decomposition check, so this must not be
' reported as a split decomposition.

@startuml detail_diagram

package "Package A" as package_a <<SEooC>> {
    component "Component A" as component_a <<component>> {
        interface "Internal Interface" as iface_int
    }
}

@enduml
