@startuml positive_conversion_operators
' Original C++ keeps both defaults and the exact non-void SFINAE helper.
' The model records type-parameter shape, not defaults/constraints; bare class
' represents the unnamed second parameter. C++ explicit is not modeled.
namespace score::memory::shared {
  class OffsetPtr<class PointedType> {
    +using pointer = PointedType*
    +operator pointer()<class T, class> const
    +operator bool() const noexcept
  }
}
@enduml
