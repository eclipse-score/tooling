@startuml negative_unsupported_template_actual_mismatch

namespace fallback {
    ' State the required value explicitly; the design does not define C++ constants.
    ' Non-type actuals currently require full-string matching, including capacity.
    struct Consumer {
        + numeric : fallback::Counted<int, 4>
    }
}

@enduml
