@startuml positive_structured_template_actual_omission

namespace structured {
    ' The explicit nested type is complete; only the outer default is omitted.
    ' Outer const/pointer/reference structure is constrained; nested omission is unsupported.
    struct Consumer {
        using Payload = structured::Envelope<structured::Inner<int>, float>;
        + value : structured::Envelope<structured::Inner<int>, float>
        + wrapped : const structured::Envelope<structured::Inner<int>, float>*
        + Read(input: const structured::Envelope<structured::Inner<int>, float>&) : const structured::Envelope<structured::Inner<int>, float>&
        + Normalize(value: const structured::Envelope<structured::Inner<int>, float>, ptr: structured::Envelope<structured::Inner<int>, float>* const) : void
        + Cv(input: volatile const structured::Envelope<structured::Inner<int>, float>* volatile const*) : void
    }
}

@enduml
