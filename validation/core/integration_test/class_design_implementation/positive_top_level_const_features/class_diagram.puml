@startuml

struct Allocator {
    - buffer_ : int* const
    + using Handle = int* const
    ' Top-level const on a by-value parameter is not part of the signature.
    + Release(p: void* const, count: const int) : void
    + Store(ptr: int*, count: int) : void
    + Keep(p: void* const) : void
    + Fill(items: const Box<int*>) : void
    + Get() : const int* const
}

namespace util {
    entity Functions <<function>> {
        + Clamp(value: const int, limit: int) : int
    }
}

@enduml
