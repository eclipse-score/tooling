@startuml positive_partial_parameters

namespace partial {
    struct Consumer {
        using Storage = partial::containers::Map<partial::types::Key, partial::types::Value, partial::types::Compare, partial::types::Allocator>
        + values : partial::containers::Map<partial::types::Key, partial::types::Value, partial::types::Compare, partial::types::Allocator>
        + Read(mode: int) const : const partial::containers::Map<partial::types::Key, partial::types::Value, partial::types::Compare, partial::types::Allocator>&
        + Write(value: const partial::containers::Map<partial::types::Key, partial::types::Value, partial::types::Compare, partial::types::Allocator>&) : void
        + Convert<typename T>(mode: int) : int
        + Select(mode: int, force: int) : int
        + Select(mode: int) : int
        + Zero() : int
    }

    ' Nonempty declaration lists omit trailing parameters, never type actuals.
    class "Declaration<typename T>" as Declaration
    class "NestedDeclaration<template<typename> class C>" as NestedDeclaration

    entity Functions <<function>> {
        + Make(mode: int) : partial::containers::Map<partial::types::Key, partial::types::Value, partial::types::Compare, partial::types::Allocator>
        + Submit(value: const partial::containers::Map<partial::types::Key, partial::types::Value, partial::types::Compare, partial::types::Allocator>&) : void
        + Convert<typename T>(mode: int) : int
        + Select(mode: int, force: int) : int
        + Select(mode: int) : int
        + Zero() : int
    }
}

@enduml
