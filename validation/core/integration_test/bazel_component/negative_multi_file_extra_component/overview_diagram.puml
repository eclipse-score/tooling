' Boundary overview: benignly re-declares the SEooC and its top-level
' component_example, without touching extra_component. Proves that merging
' this file in doesn't suppress (or duplicate) the pre-existing
' extra-component-vs-Bazel detection for extra_component, which is declared
' solely in component_diagram.puml.

@startuml overview_diagram

package "Sample Seooc" as safety_software_seooc_example <<SEooC>> {
    component "Component Example" as component_example <<component>>
}

@enduml
