"""Documentation path of a label."""

_REPO_SEPARATORS = ["+", "~"]

def repo_segment(label):
    """Return `_main` for the main repo, else the module name of the repo.

    Canonical names (`mod+`, `mod+<version>`, `mod~<version>`) differ between
    Bazel versions, so only the module name is kept. Repos generated by a
    module extension (`mod++ext+repo`) keep their full canonical name.
    """
    repo = label.repo_name
    if not repo:
        return "_main"
    for separator in _REPO_SEPARATORS:
        module, found, rest = repo.partition(separator)
        if found and not any([s in rest for s in _REPO_SEPARATORS]):
            return module
    return repo

def label_path(label):
    """Return `<repo>/<package>/<name>` for `label`; the main repo is `_main`.

    Different labels can share a path (`//a:b/c` and `//a/b:c`), and paths can
    nest (`//a:b` and `//a/b:c`), so callers that stage files below it must
    detect clashes.
    """
    segments = [repo_segment(label)]
    if label.package:
        segments.append(label.package)
    segments.append(label.name)
    return "/".join(segments)
