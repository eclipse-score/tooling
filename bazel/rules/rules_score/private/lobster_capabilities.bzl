"""Detect optional features of the resolved ``lobster`` module.

``subrule_lobster_gtest`` gained the keyword argument
``derive_gwt_from_test_name`` after the 1.0.6 release. Passing an unknown
keyword argument to a subrule is an analysis error, and Starlark offers no way
to introspect a subrule's signature, so the capability is probed by reading
lobster's own rule definition.

The result is exposed as a load-time constant through a generated repository,
which lets the call sites choose the matching invocation. Pinning a lobster
version that predates the feature therefore degrades to the previous behaviour
instead of breaking the build, and bumping to a version that provides it
enables the feature without any further change.
"""

_DERIVE_GWT_FROM_TEST_NAME = "derive_gwt_from_test_name"

# Definition of the gtest rule inside the lobster module. A restructuring of
# lobster makes the probe report "unsupported", which is the safe answer.
_LOBSTER_GTEST_BZL = Label("@lobster//bazel/private:lobster_gtest.bzl")

_CAPABILITIES_TEMPLATE = """\
\"\"\"Generated by //bazel/rules/rules_score/private:lobster_capabilities.bzl.

Do not edit. Describes the features of the lobster module that the current
dependency resolution selected.
\"\"\"

# Whether subrule_lobster_gtest accepts the keyword argument
# "derive_gwt_from_test_name".
SUPPORTS_DERIVE_GWT_FROM_TEST_NAME = {derive_gwt_from_test_name}
"""

def _lobster_capabilities_repo_impl(repository_ctx):
    definition = repository_ctx.read(repository_ctx.path(_LOBSTER_GTEST_BZL))
    repository_ctx.file("BUILD.bazel", "")
    repository_ctx.file(
        "capabilities.bzl",
        _CAPABILITIES_TEMPLATE.format(
            derive_gwt_from_test_name = repr(_DERIVE_GWT_FROM_TEST_NAME in definition),
        ),
    )

_lobster_capabilities_repo = repository_rule(
    implementation = _lobster_capabilities_repo_impl,
    doc = "Generates a .bzl file holding the probed lobster feature flags.",
)

def _lobster_capabilities_impl(_module_ctx):
    _lobster_capabilities_repo(name = "lobster_capabilities")

lobster_capabilities = module_extension(
    implementation = _lobster_capabilities_impl,
    doc = "Provides the @lobster_capabilities repository.",
)
