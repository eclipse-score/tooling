# L4 end-to-end tests of rules_score: consumer builds run in nested Bazel.
# Separate module (ignored by the root workspace); run from this directory.
module(
    name = "rules_score_integration_test",
    version = "0.0.0",
)

bazel_dep(name = "rules_bazel_integration_test", version = "0.37.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "score_tooling", version = "0.0.0")
local_path_override(
    module_name = "score_tooling",
    path = "../../../..",
)

bazel_binaries = use_extension(
    "@rules_bazel_integration_test//:extensions.bzl",
    "bazel_binaries",
)

# Same Bazel version as the root workspace.
bazel_binaries.download(version_file = "@score_tooling//:.bazelversion")
use_repo(
    bazel_binaries,
    "bazel_binaries",
    "bazel_binaries_bazelisk",
    "build_bazel_bazel_.bazelversion",
)
