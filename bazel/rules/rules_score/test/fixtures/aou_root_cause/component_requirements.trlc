// Regression fixture: a CompReq derived from a generated fault-tree root cause
// (package AouRootCauseFta). Resolving that reference needs the safety_analysis
// target in the `deps` of component_requirements, both for TRLC parsing and for
// the "Root Causes" level of the component LOBSTER report.
package TestComponent

import ScoreReq
import AouRootCauseFta
import TestSEooC

ScoreReq.CompReq REQ_COMP_TEST_001 {
    description = "The mock library shall provide mock_function_1 returning 42 and mock_function_2 returning 84"
    safety = ScoreReq.Asil.B
    derived_from = [TestSEooC.FEAT_TEST_001@1, AouRootCauseFta.UserProvidedWrongConfiguration]
    version = 1
}