// Regression fixture: an AoU that prevents a generated fault-tree root cause
// (package AouRootCauseFta). Resolving that reference needs the
// fault_trees target in the `deps` of assumptions_of_use.
package AouRootCauseAous

import ScoreReq
import AouRootCauseFta

ScoreReq.AoU ConfigurationIsCorrect {
    description = "The user shall provide a correct configuration"
    safety = ScoreReq.Asil.B
    version = 1
    root_causes = [AouRootCauseFta.UserProvidedWrongConfiguration]
}
