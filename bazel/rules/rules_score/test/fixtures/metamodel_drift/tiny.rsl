package ScoreReq

enum Color {
    Red
    Blue
}

abstract type Common {
    version "Version value." String
    inherited "Inherited text." optional String
}

abstract type OtherCommon extends Common {
}

type TargetA extends Common {
}

type TargetB extends Common {
}

tuple TargetRef {
    item [TargetA, TargetB]
}

type Feature extends Common {
    color "Color value." Color
    enabled "Enabled flag." optional Boolean
    refs "Links to target records." TargetRef[1 .. *]
    optional_refs "Optional links." optional TargetRef[1 .. *]
    extra "Extra value." String
    obsolete "Generated field." String
    maybe "Optional text." optional String
}

type RemovedThing extends Common {
}

type Unmapped extends Common {
}
