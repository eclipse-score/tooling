package PublicApiExampleFmea

import ScoreReq

ScoreReq.FailureMode PublicInterfaceFailure {
    guidewords = [ScoreReq.Guideword.LossOfFunction]
    description = "PublicInterface stops responding"
    failureeffect = "Callers never receive a response"
    version = 1
    safety = ScoreReq.Asil.B
    interface = "package_pub.PublicInterface"
}
