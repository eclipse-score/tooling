package DynamicExampleFmea

import ScoreReq

ScoreReq.FailureMode TaskInterfaceFailure {
    guidewords = [ScoreReq.Guideword.LossOfFunction]
    description = "TaskInterface stops responding"
    failureeffect = "Tasks are never dispatched to the Worker"
    version = 1
    safety = ScoreReq.Asil.B

    interface = "TaskInterface.AssignTask"
}
