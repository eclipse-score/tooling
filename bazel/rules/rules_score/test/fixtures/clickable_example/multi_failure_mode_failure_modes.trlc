package MultiFailureModeExampleSafetyAnalysis

import ScoreReq

ScoreReq.FailureMode MessageLost {
    guidewords = [ScoreReq.Guideword.LossOfFunction]
    description = "Message is lost in transit"
    failureeffect = "Receiver never gets the message"
    version = 1
    safety = ScoreReq.Asil.B
    interface = "package_pub.PublicInterface"
}

ScoreReq.FailureMode MessagePartiallyDelivered {
    guidewords = [ScoreReq.Guideword.PartialFunction]
    description = "Message is only partially delivered"
    failureeffect = "Receiver processes incomplete data"
    version = 1
    safety = ScoreReq.Asil.B
    interface = "package_pub.PublicInterface"
}

ScoreReq.FailureMode MessageCorrupted {
    guidewords = [ScoreReq.Guideword.Corrupted]
    description = "Message content is corrupted in transit"
    failureeffect = "Receiver processes wrong data"
    version = 1
    safety = ScoreReq.Asil.B
    interface = "package_pub.PublicInterface"
}
