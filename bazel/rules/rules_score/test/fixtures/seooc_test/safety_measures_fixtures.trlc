// Fixture exercising the Measure type hierarchy (SafetyMeasure/Mitigation/AoU/
// CompReq): every fault-tree root cause (RootCause) must be addressed by at
// least one concrete measure.
// - SafetyMeasure: abstract, never instantiated directly; only exists so
//   Mitigation can inherit the mandatory ``root_causes`` field.
// - Mitigation: extends SafetyMeasure, adds a mandatory ``justification``
//   explaining why the root cause does not apply in this context.
// - AoU: independent type (does not extend SafetyMeasure); its
//   ``root_causes`` field is optional -- an AoU acts as a preventive measure
//   only when it addresses a fault-tree root cause.
// - CompReq (elsewhere): acts as a control measure when its ``derived_from``
//   references a fault-tree RootCause.

package TestSafetyMeasures

import ScoreReq

ScoreReq.FailureMode SomeFailureMode {
    guidewords    = [ScoreReq.Guideword.LossOfFunction]
    failureeffect = "Some effect"
    safety        = ScoreReq.Asil.B
    description   = "A failure mode backing this fixture's fault tree"
    version       = 1
}

ScoreReq.RootCause SomeRootCause {
    title         = "Some root cause"
    diagram       = "n/a"
    line          = 1
    failure_modes = [TestSafetyMeasures.SomeFailureMode]
}

ScoreReq.Mitigation SomeMitigation {
    safety        = ScoreReq.Asil.B
    description   = "Mitigation linked to the FTA RootCause via an explicit root_causes reference"
    justification = "This root cause cannot occur in this context because of an independent design property"
    version       = 1
    root_causes   = [TestSafetyMeasures.SomeRootCause]
}

ScoreReq.AoU SomeAoU {
    safety      = ScoreReq.Asil.B
    description = "An assumption of use that also addresses a fault-tree root cause"
    version     = 1
    root_causes = [TestSafetyMeasures.SomeRootCause]
}
