@startuml get_data_async_overview

' Same level, asynchronous: the call is a black box. The window of an
' asynchronous call ends at `score-window-end`.

participant unit_1 <<unit>>
participant unit_2 <<unit>>

unit_1 ->> unit_2 : GetData()
ref over unit_2 : score-window-end

@enduml
