@startuml get_number_component

' Zoom level 1: the SEooC opened at its component. Same sender and method as
' get_number_seooc.puml; the component hands the work to unit_1.

actor App
participant "safety_software_seooc_example::component_example" as component_example <<component>>
participant unit_1 <<unit>>
participant Platform <<external>>

App -> component_example : GetNumber()
activate component_example
component_example -> unit_1 : GetNumber()
unit_1 --> component_example : number
component_example -> Platform : Log()
component_example --> App : number
deactivate component_example

@enduml
