@startuml safety_analysis_linkage

' Record linkage of a dependable element's safety analysis.  Arrows point from
' the referencing record to the referenced one; the label is the TRLC field.

skinparam ArrowFontSize 10
skinparam defaultTextAlignment center
skinparam nodesep 60
skinparam ranksep 70

skinparam class {
    BackgroundColor<<authored>> #EFF6FB
    BorderColor<<authored>>     #0066B1
    BackgroundColor<<generated>> #FFF3E0
    BorderColor<<generated>>     #EF6C00
    BackgroundColor<<received>>  #F3E5F5
    BorderColor<<received>>      #7B1FA2
}

package "Other dependable_element (listed in deps)" {
    class "AoU\n(received)" as RecvAoU <<received>>
}

package "This dependable_element" {
    package "Safety analysis" {
        class FailureMode <<authored>> {
            interface
        }
        class RootCause <<generated>> {
            title
            diagram
            line
        }
        class RootCauseAssessment <<authored>> {
            safety
            rationale
            version
        }
        class "AoU\n(own)" as OwnAoU <<authored>>
    }

    package "Requirements" {
        class CompReq <<authored>>
        class FeatReq <<authored>>
        class AssumedSystemReq <<authored>>
    }
}

' ── Generated from the $RootCause macros of the FTA diagrams ────────────────
RootCause "1..*" --> FailureMode : failure_modes

' ── Assessment: every RootCause is covered by exactly one assessment ────────
RootCauseAssessment "0..*" --> "1..*" RootCause : root_causes
RootCauseAssessment "0..*" --> "0..*" OwnAoU : measures @version\n(preventive)
RootCauseAssessment "0..*" --> "0..*" CompReq : measures @version\n(control)

' ── Requirement chain ───────────────────────────────────────────────────────
CompReq --> FeatReq : derived_from
CompReq --> AssumedSystemReq : derived_from
CompReq --> RecvAoU : derived_from\n(received AoU only)
FeatReq --> AssumedSystemReq : derived_from

note bottom of RootCause
  Every RootCause is covered by exactly one
  RootCauseAssessment.
end note

note bottom of RootCauseAssessment
  No measures: the root causes do not apply
  (the rationale says why).
end note

note bottom of OwnAoU
  Own AoUs are never a CompReq
  derived_from source.
end note

@enduml
