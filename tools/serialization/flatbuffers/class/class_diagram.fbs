namespace class_metamodel;

table SourceLocation {
    file: string;
    line: uint32;
}

enum Visibility : byte {
    Public = 0,
    Private = 1,
    Protected = 2
}

enum EntityType : byte {
    Class = 0,
    Struct = 1,
    Interface = 2,
    AbstractClass = 3,
    Enum = 4
}

enum ClassTemplateKind : byte {
    NonTemplate = 0,
    Primary = 1,
    PartialSpecialization = 2,
    ExplicitSpecialization = 3
}

enum RelationType : byte {
    Inheritance = 0,
    Implementation = 1,
    Composition = 2,
    Aggregation = 3,
    Association = 4,
    Dependency = 5
}

enum MethodModifier : byte {
    Static = 0,
    Virtual = 1,
    Abstract = 2,
    Override = 3,
    Constructor = 4,
    Destructor = 5,
    Noexcept = 6,
    Final = 7,
    Const = 8
}

enum TemplateParameterKind : byte {
    Type = 0,
    NonType = 1,
    Template = 2
}

table BuiltinType {
    name: string (required);
}

table TemplateValue {
    text: string (required);
}

union TypeArgumentValue {
    TypeExpr,
    TemplateValue
}

table TypeArgument {
    value: TypeArgumentValue;
}

table TypeNameSegment {
    name: string (required);
    arguments: [TypeArgument];
}

table QualifiedTypeName {
    segments: [TypeNameSegment];
    is_global: bool = false;
}

table NamedType {
    name: QualifiedTypeName (required);
}

table TemplateType {
    name: QualifiedTypeName (required);
    arguments: [TypeArgument];
}

table ArrayType {
    element: TypeExpr (required);
    size: string;
}

table FunctionType {
    return_type: TypeExpr (required);
    parameter_types: [TypeExpr];
    is_variadic: bool = false;
    is_noexcept: bool = false;
}

table PointerType {
    inner: TypeExpr (required);
}

table ReferenceType {
    inner: TypeExpr (required);
}

table RValueReferenceType {
    inner: TypeExpr (required);
}

table ConstType {
    inner: TypeExpr (required);
}

table VolatileType {
    inner: TypeExpr (required);
}

union TypeExprValue {
    BuiltinType,
    NamedType,
    TemplateType,
    ArrayType,
    FunctionType,
    PointerType,
    ReferenceType,
    RValueReferenceType,
    ConstType,
    VolatileType
}

table TypeExpr {
    value: TypeExprValue;
}

table TypeDescription {
    raw_text: string (required);
    expression: TypeExpr;
}

table TemplateParameter {
    kind: TemplateParameterKind = Type;
    name: string (required);
    value_type: string;
    parameters: [TemplateParameter];
    is_pack: bool = false;
}

table TypeAlias {
    alias: string (required);
    original_type: TypeDescription (required);
    source_location: SourceLocation (required);
}

enum ParameterDirection : byte {
    Unspecified = 0,
    In = 1,
    Out = 2,
    InOut = 3
}

table FunctionArgument {
    name: string (required);
    param_type: TypeDescription;
    is_variadic: bool = false;
    is_pack_expansion: bool = false;
    direction: ParameterDirection = Unspecified;
    multiplicity: string;
}

table MemberVariable {
    name: string (required);
    data_type: TypeDescription;
    visibility: Visibility = Public;
    is_static: bool = false;
    source_location: SourceLocation (required);
}

table Method {
    name: string (required);
    return_type: TypeDescription;
    visibility: Visibility = Public;
    parameters: [FunctionArgument];
    template_parameters: [TemplateParameter];
    modifiers: [MethodModifier];
    source_location: SourceLocation (required);
    return_multiplicity: string;
    conversion_target: string;
}

table EnumLiteral {
    name: string (required);
    value: string;
    source_location: SourceLocation (required);
}

table Relationship {
    source: string (required);
    target: string (required);
    relation_type: RelationType = Association;
    source_multiplicity: string;
    target_multiplicity: string;
    source_location: SourceLocation (required);
}

table SimpleEntity {
    id: string (required);
    name: string (required);
    enclosing_namespace_id: string;
    entity_type: EntityType = Class;
    type_aliases: [TypeAlias];
    variables: [MemberVariable];
    methods: [Method];
    template_parameters: [TemplateParameter];
    enum_literals: [EnumLiteral];
    relationships: [Relationship];
    source_location: SourceLocation (required);
    stereotypes: [string];
    template_kind: ClassTemplateKind = NonTemplate;
}

table FreeFunctionDecl {
    name: string (required);
    enclosing_namespace_id: string;
    return_type: TypeDescription;
    parameters: [FunctionArgument];
    template_parameters: [TemplateParameter];
    source_location: SourceLocation (required);
    return_multiplicity: string;
}

table ClassDiagram {
    name: string (required);
    entities: [SimpleEntity];
    free_functions: [FreeFunctionDecl];
    /// Source path of the diagram file (`--source-name`)
    source: string;
}

root_type ClassDiagram;

file_identifier "CLSD";
file_extension "clsd";
