@startuml clickable_plantuml_pipeline
title From .puml source to a clickable diagram - pipeline steps and artifacts

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam componentStyle rectangle

skinparam component {
  BackgroundColor<<step>> #FFF8E1
  BorderColor<<step>> #F9A825
  BackgroundColor<<external>> #F5F5F5
  BorderColor<<external>> #757575
}
skinparam artifact {
  BackgroundColor<<artifact>> #E3F2FD
  BorderColor<<artifact>> #1565C0
}

artifact ".puml source file\n(path: workspace-relative,\nfrom puml_file.short_path)" as PumlSrc <<artifact>>

component "puml_cli: parse & resolve" as Step1 <<step>> {
  component "puml_parser\n(pest grammar -> AST)" as Parser
  component "puml_resolver\n(alias/reference\nresolution)" as Resolver
  Parser -right-> Resolver
}

artifact "<stem>.fbs.bin\n(resolved diagram model,\nsource, @startuml name)" as Fbs <<artifact>>

component "validation_cli: diagram links\n(dependable_element)" as Step2 <<step>> {
  component "element links:\nreference -> diagram\nthat defines it" as ElementLinks
  component "call links:\ncall -> diagrams\nthat refine it" as CallLinks
}

artifact "<name>_index/diagram_links.json\n(element_links[], call_links[])" as Links <<artifact>>

component "clickable_plantuml: Sphinx extension" as Step3 <<step>> {
  component "builder-inited\n(load diagram_links.json)" as BuilderInited
  component "doctree-resolved\n(inject \"url of X is [[link]]\"\nand call links)" as DoctreeResolved
  BuilderInited -right-> DoctreeResolved
}

component "sphinxcontrib-plantuml" as Step4 <<external>> {
  component "renders uml text -> SVG/PNG" as Render
}

artifact "clickable SVG/PNG\nin the built docs" as Output <<artifact>>

PumlSrc --> Step1 : consumed by
Step1 --> Fbs : produces\n(one per diagram)
Fbs --> Step2 : consumed by\n(all diagrams of the\ndependable element)
Step2 --> Links : produces
Links --> Step3 : consumed by\n(every diagram_links.json\nin the source tree)
Step3 --> Step4 : hands off\nannotated uml to
Step4 --> Output : produces

@enduml
