@startuml free_function_entity

namespace amp {
    namespace algorithm {
        entity Placeholder <<function>> {
            + clamp(value, min, max)
            + Submit<CallableType, ArgumentTypes...>(callable, arguments)
        }
    }
}

entity amp.algorithm.Qualified <<function>> {
    + qualified()
}

@enduml
