@startuml overview

namespace WorkerUnit <<unit>> {
    class Worker
}
namespace Module <<unit>> {
    class ModuleClient
}
namespace Other <<unit>> {
    class OtherClient
}

Module.ModuleClient ..> WorkerUnit.Worker
Other.OtherClient ..> WorkerUnit.Worker

' Recommended organization: declare the endpoints and draw dependencies here.
' Both Clients use one Worker; detail.puml provides its members only once.
' Separate module/other diagrams need no Worker declaration when these
' dependencies are drawn only in the overview. Repeated Worker declarations remain
' supported in the same-name boundary test, but are not needed here.
@enduml
