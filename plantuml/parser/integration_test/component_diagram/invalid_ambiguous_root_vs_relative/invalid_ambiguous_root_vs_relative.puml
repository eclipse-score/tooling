@startuml

component "a" as a <<component>> {
    component "B" as B <<unit>>
}

component "x" as x <<component>>

package "pkg" as pkg #LightBlue {
    component "a" as a <<component>> {
        component "B" as B <<unit>>
    }

    x --> a.B : ambiguous
}

@enduml
