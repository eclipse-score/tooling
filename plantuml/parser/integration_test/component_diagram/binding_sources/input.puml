@startuml binding_regression_bare_sources
component Plain
component Unit <<unit>>
package Comp <<component>>
package Seooc <<SEooC>>
component WithOut {
    portout outgoing
}
component WithPort {
    port generic
}
interface Bare
interface Layout
interface Styled
Plain - Bare : provides
Plain -u- Layout : provides
Plain -[bold]- Styled : provides
Unit - Bare : provides
Comp - Bare : provides
Seooc - Bare : provides
outgoing - Bare : provides
generic - Bare : provides
interface DoubleBare
interface DoubleLayout
interface DoubleStyled
Plain -- DoubleBare : provides
Plain --u-- DoubleLayout : provides
Plain --[bold]-- DoubleStyled : provides
interface Reverse
Reverse -- Plain : provides
Reverse - Unit : provides
Reverse -- Comp : provides
Reverse - Seooc : provides
Reverse -- "outgoing" : provides
Reverse - generic : provides
@enduml
