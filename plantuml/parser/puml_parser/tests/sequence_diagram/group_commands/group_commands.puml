@startuml group_commands

alt successful path
    Alice -> Bob : success
else fallback path
    Alice -> Bob : fallback
end alt

loop retry while pending
    Alice -> Bob : retry
end

group custom section
    Alice -> Bob : custom
end

par parallel branch
    Alice -> Bob : branch
end

break stop early
    Alice -> Bob : stop
end

critical exclusive section
    Alice -> Bob : exclusive
end critical

@enduml
