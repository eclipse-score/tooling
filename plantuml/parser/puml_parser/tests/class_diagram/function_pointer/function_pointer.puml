@startuml function_pointer

class CallbackRegistry {
    + using Callback = void (*)(std::vector<std::shared_ptr<app::Payload>>)
    + callback : const app::Result* (* const)(const app::Payload&) noexcept
    + Set(handler : void (*)(int, ...)) : void
    + Handler() : void (*)(app::Request&&, void (*)(int))
}

@enduml
