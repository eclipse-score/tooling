@startuml parameter_multiplicities

class ParameterMultiplicities {
    + data : T[1]
    + bounded : T[N]
    + empty : T[]
    + Optional(in x : Shared<T>[0..1], count : int = 2) : void
    + ZeroOrMore(in x : Shared<T>[0..*], count : int = 2) : void
    + OneOrMore(in x : Shared<T>[1..*], count : int = 2) : void
    + Star(in x : Shared<T>[*], count : int = 2) : void
    + Range(in x : Shared<T>[2..5], count : int = 2) : void
    + EqualBounds(in x : Shared<T>[0..0], count : int = 2) : void
    + LeadingZeros(in x : Shared<T>[01..02], count : int = 2) : void
    + Whitespace(in x : Shared<T>[ 0 .. * ], count : int = 2) : void
    + MaxLowerBound(in x : Shared<T>[18446744073709551615..*], count : int = 2) : void
    + DirectionsAndDefaults(out output : Shared<T>[0..1], inout state : Shared<T>[1..*], plain : Shared<T>[*] = nullptr, maximum : Shared<T>[0..18446744073709551615]) : void
    + Arrays(x : T[1], T[1] y, T[1], z : T[N], empty : T[]) : T[1]
    + BoundedArray() : T[N]
    + EmptyArray() : T[]
}

@enduml
