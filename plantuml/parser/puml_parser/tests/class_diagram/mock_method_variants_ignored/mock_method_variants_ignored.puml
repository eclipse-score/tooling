@startuml mock_method_variants_ignored
class MockOutput {
    + MOCK_METHOD1(Foo, bool(int value));
    + MOCK_METHOD0(Foo, void());
    + MOCK_CONST_METHOD2_T(Bar, void(int, float));
    + MOCK_METHOD1_WITH_CALLTYPE(STDMETHODCALLTYPE, Foo, bool(int value));

    + MOCK_METHOD(void, Write, (int value));
    + MOCK_METHOD(void, Write, (int, float), (override));
    + MOCK_METHOD(void, Write, (int value), (override, final));
    + MOCK_METHOD(std::vector<int>, Get, (), (const));
    + MOCK_METHOD((std::pair<int,int>), Get, (), (const, override));
    + MOCK_METHOD(void, Flush, (), (Calltype(STDMETHODCALLTYPE), ref(&), noexcept, final));

    + MOCK_METHOD(void, Write,
        (int value), (override));
    + MOCK_METHOD((
        std::pair<int,int>
    ), GetWrapped, (), (const, override));
    + MOCK_METHOD(
        std::vector<std::pair<int, int>>,
        SplitEverywhere,
        (int first,
         float second),
        (const,
         noexcept,
         final));
}
@enduml
