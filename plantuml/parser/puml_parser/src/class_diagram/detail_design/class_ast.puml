@startuml
title UML AST Core Structure - Full Fields with Types

skinparam linetype ortho
skinparam classAttributeIconSize 0

' ========================
' AST
' ========================
class ClassLikeDef {
  declaration: DeclarationCommon
  template_parameters: Option<Vec<String>>
  members: ClassLikeMembers
  kind: ClassLikeKind
}

enum ClassLikeKind {
  Class
  Struct
  Interface
}

class EntityDef {
  declaration: DeclarationCommon
  methods: Vec<Method>
}

class EnumDef {
  declaration: DeclarationCommon
  items: Vec<EnumItem>
}

class DeclarationCommon {
  name: Name
  namespace: String
  package: String
  stereotypes: Vec<String>
  source_location: SourceLocation
}

class ClassLikeMembers {
  attributes: Vec<Attribute>
  type_aliases: Vec<TypeAlias>
  methods: Vec<Method>
}

class EnumItem {
  name: String
  value: Option<EnumValue>
  source_location: SourceLocation
}

class Relationship {
  left: String
  right: String
  arrow: Arrow
  left_multiplicity: Option<String>
  right_multiplicity: Option<String>
  label: Option<String>
  source_location: SourceLocation
}

class TypeAlias {
  alias: String
  original_type: String
  source_location: SourceLocation
}

class Namespace {
  name: Name
  source_location: SourceLocation
  types: Vec<TypeDefinition>
  relationships: Vec<Relationship>
  namespaces: Vec<Namespace>
}

class Package {
  name: Name
  source_location: SourceLocation
  types: Vec<TypeDefinition>
  packages: Vec<Package>
  relationships: Vec<Relationship>
}

class ClassUmlFile {
  name: String
  elements: Vec<ClassUmlTopLevel>
  relationships: Vec<Relationship>
}

class Method {
  visibility: Visibility
  name: String
  template_parameters: Option<Vec<String>>
  params: Vec<Param>
  type: Option<String>
  modifiers: Vec<String>
  is_friend: bool
  source_location: SourceLocation
}

class Attribute {
  visibility: Visibility
  name: String
  type: Option<String>
  modifiers: Vec<String>
  source_location: SourceLocation
}

' ========================
' enum
' ========================
enum TypeDefinition {
  ClassLikeDef
  EntityDef
  EnumDef
}

enum ClassUmlTopLevel {
  TypeDefinition
  Namespace
  Package
}

' ========================
' relationship
' ========================
ClassLikeDef "1" *-- "1" DeclarationCommon
ClassLikeDef "1" *-- "1" ClassLikeMembers
ClassLikeDef "1" *-- "1" ClassLikeKind
EntityDef "1" *-- "1" DeclarationCommon
EntityDef "1" o-- "*" Method
EnumDef "1" *-- "1" DeclarationCommon

ClassLikeMembers "1" o-- "*" Attribute
ClassLikeMembers "1" o-- "*" TypeAlias
ClassLikeMembers "1" o-- "*" Method

EnumDef "1" o-- "*" EnumItem

TypeDefinition "1" *-- "1" ClassLikeDef
TypeDefinition "1" *-- "1" EntityDef
TypeDefinition "1" *-- "1" EnumDef

Namespace "1" o-- "*" TypeDefinition
Namespace "1" o-- "*" Relationship
Namespace "1" o-- "*" Namespace

Package "1" o-- "*" TypeDefinition
Package "1" o-- "*" Package
Package "1" o-- "*" Relationship

ClassUmlFile "1" o-- "*" ClassUmlTopLevel
ClassUmlFile "1" o-- "*" Relationship
ClassUmlTopLevel "1" *-- "1" TypeDefinition
ClassUmlTopLevel "1" *-- "1" Namespace
ClassUmlTopLevel "1" *-- "1" Package

@enduml
